#include <SPI.h>
#include <PN532_SPI.h>
#include <NfcAdapter.h>
#include <Keypad.h>
#include <LiquidCrystal_I2C.h>
#include <Wire.h>
#include <Servo.h>


// combination of 16x2 LCD Display,Keypad to LCD data transfer, and a continuous servo motor
// also uses transationApp (https://github.com/csmith1188/IRLTech/tree/testing/transactionApp)


#define limitSwitchPin A3

// LCD pins: RS, E, D4, D5, D6, D7
LiquidCrystal_I2C lcd(0x27, 16, 2);

int counter = 0;

Servo myServo;

// NFC on SPI using SS on pin 10 (adjust as needed)
PN532_SPI pn532spi(SPI, 10);
NfcAdapter nfc = NfcAdapter(pn532spi);

// Keypad setup
const byte ROWS = 4;
const byte COLS = 4;
char hexaKeys[ROWS][COLS] = {
  { '1', '2', '3', 'A' },
  { '4', '5', '6', 'B' },
  { '7', '8', '9', 'C' },
  { '*', '0', '#', 'D' }
};
byte rowPins[ROWS] = { 3, 4, 2, 8 };
byte colPins[COLS] = { 7, 6, 5, A0 };
Keypad customKeypad = Keypad(makeKeymap(hexaKeys), rowPins, colPins, ROWS, COLS);

// Input handling
char terminatorKey = '#';
bool inputMode = false;
String Input = "";


// Tag ID storage
String tagId;

void setup() {
  Serial.begin(9600);
  lcd.init();
  lcd.backlight();
  nfc.begin();
  pinMode(limitSwitchPin, INPUT_PULLUP);
}

void loop() {
  // Handle serial commands
  if (Serial.available()) {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();
    lcd.clear();
    lcd.print(cmd);

    if (cmd.startsWith("INPUT")) {
      inputMode = true;
      Serial.println(">> INPUT MODE ON");
      Input = "";
      lcd.clear();
      lcd.print("Enter number:");
      lcd.setCursor(0, 1);

    } else if (cmd.startsWith("LCD:")) {
      lcd.clear();
      lcd.print(cmd.substring(4));

    } else if (cmd.startsWith("READNFC")) {
      readNFC();

    } else if (cmd.startsWith("READREC")) {
      int rec = cmd.substring(7).toInt();
      readRecord(rec);

    } else if (cmd.startsWith("WRITEREC")) {
      // Format: WRITEREC <recordNumber> <payload>
      int firstSpace = cmd.indexOf(' ');
      int secondSpace = cmd.indexOf(' ', firstSpace + 1);
      int recNum = cmd.substring(firstSpace + 1, secondSpace).toInt();
      String payload = cmd.substring(secondSpace + 1);
      writeRecord(recNum, payload);
    }
  }

  if (!inputMode) {
    char key = customKeypad.getKey();

    if (key == 'A') {
      myServo.attach(9);   // Reattach if needed
      myServo.write(100);  // Clockwise
      lcd.print("going down");
      delay(10000);  // Duration
      lcd.clear();
      myServo.detach();  // Stop
      Serial.println("Going down");
    }

    if (key == 'B') {
      myServo.attach(9);  // Reattach if needed
      myServo.write(10);  // CounterClockwise
      lcd.print("going up");
      Serial.println("Going up");
      delay(1000);  // Duration
      counter++;
      lcd.clear();
      lcd.print(counter);
      Serial.println(counter);
      myServo.detach();  // Stop
    }

    if (key == 'C') {
      calibrateTube();
    }

    if (key == 'D') {
      dispensePog();
    }
  }

  // Handle keypad input mode
  if (inputMode) {
    char key = customKeypad.getKey();
    if (key && key != NO_KEY) {
      if (key == terminatorKey) {
        Serial.print("INPUT:");
        Serial.println(Input);
        inputMode = false;
        lcd.clear();
      } else {
        Serial.print("GOT KEY: ");
        Serial.println(key);
        Input += key;
        lcd.print(key);
      }
    }
  }
}

// ----- NFC Functions -----

void readNFC() {
  if (nfc.tagPresent()) {
    NfcTag tag = nfc.read();
    tag.print();

    tagId = tag.getUidString();
    NdefMessage message = tag.getNdefMessage();
    int recordCount = message.getRecordCount();
    Serial.print("Number of records on the tag: ");
    Serial.println(recordCount);
  }
  delay(5000);
}

String removeNonNumeric(String str) {
  String newStr = "";
  for (char c : str) {
    if (isdigit(c)) newStr += c;
  }
  return newStr;
}

void readRecord(int recordNumber) {
  if (nfc.tagPresent()) {
    NfcTag tag = nfc.read();
    Serial.println(tag.getTagType());
    Serial.print("UID: ");
    Serial.println(tag.getUidString());

    if (tag.hasNdefMessage()) {
      NdefMessage message = tag.getNdefMessage();
      int count = message.getRecordCount();
      Serial.print("\nThis NFC Tag contains an NDEF Message with ");
      Serial.print(count);
      Serial.print(" NDEF Record");
      if (count != 1) Serial.print("s");
      Serial.println(".");

      Serial.print("\nNDEF Record ");
      Serial.println(recordNumber + 1);
      NdefRecord record = message.getRecord(recordNumber);

      Serial.print("  TNF: ");
      Serial.println(record.getTnf());
      Serial.print("  Type: ");
      Serial.println(record.getType());

      int payloadLength = record.getPayloadLength();
      byte payload[payloadLength];
      record.getPayload(payload);
      Serial.print("  Payload (HEX): ");
      PrintHexChar(payload, payloadLength);

      String payloadAsString = "";
      for (int i = 0; i < payloadLength; i++) payloadAsString += (char)payload[i];
      Serial.print("  Payload (as String): ");
      Serial.println(payloadAsString);

      int idx1 = payloadAsString.indexOf(',');
      int idx2 = payloadAsString.indexOf(',', idx1 + 1);
      String wins = removeNonNumeric(payloadAsString.substring(0, idx1));
      String losses = removeNonNumeric(payloadAsString.substring(idx1 + 1, idx2));
      String draws = removeNonNumeric(payloadAsString.substring(idx2 + 1));

      Serial.print("Wins: ");
      Serial.println(wins.toInt());
      Serial.print("Losses: ");
      Serial.println(losses.toInt());
      Serial.print("Draws: ");
      Serial.println(draws.toInt());

      String uid = record.getId();
      if (uid == "") {
        record.setId(recordNumber, 4);
      } else {
        Serial.print("  ID: ");
        Serial.println(uid);
      }
    }
  }
  delay(3000);
}

void writeRecord(int recordNumber, String payload) {
  if (nfc.tagPresent()) {
    NfcTag tag = nfc.read();
    Serial.println(tag.getTagType());
    Serial.print("UID: ");
    Serial.println(tag.getUidString());

    if (tag.hasNdefMessage()) {
      NdefMessage message = tag.getNdefMessage();
      NdefMessage newMessage;

      int recordCount = message.getRecordCount();
      for (int i = 0; i < recordCount; i++) {
        if (i == recordNumber) {
          newMessage.addTextRecord(payload);
        } else {
          NdefRecord rec = message.getRecord(i);
          newMessage.addRecord(rec);
        }
      }

      if (recordNumber >= recordCount) {
        newMessage.addTextRecord(payload);
      }

      nfc.erase();
      bool success = nfc.write(newMessage);
      if (success) Serial.println("Success. Try reading this tag with your phone.");
      else Serial.println("Write failed");
    }
  }
  delay(3000);
}


void calibrateTube() {
  myServo.attach(9);   // Reattach if needed
  myServo.write(180);  // CounterClockwise
  lcd.print("going down");
  while (digitalRead(limitSwitchPin) != HIGH) {
    delay(100);  // Duration
  }
  myServo.detach();  // Stop
}

void dispensePog() {
  myServo.attach(9);   // Reattach if needed
  myServo.write(90);  // Clockwise
  lcd.print("dispensing");
  int sensorRead = analogRead(A2);
  Serial.println(sensorRead);

  while (sensorRead - 38 < 20 && digitalRead(limitSwitchPin) != HIGH) {
    // delay(1);  // Duration
    sensorRead = analogRead(A2);
    Serial.println(sensorRead);
  }
  lcd.clear();
  myServo.detach();  // Stop
}
